+	touch debian/$(PMX_KERNEL_PKG)/usr/lib/proxmox-kernel/$(KVNAME)/.proxmox-amlogic-kernel
 	$(MAKE) -C $(KERNEL_SRC) INSTALL_MOD_PATH=$(BUILD_DIR)/debian/$(PMX_KERNEL_PKG)/usr/ modules_install
